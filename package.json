{
  "name": "qlik-cloud-embed-oauth-impersonation",
  "description": "Demo app showing qlik-embed and qlik/api with OAuth impersonation in Qlik Cloud.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qlik-oss/qlik-cloud-embed-oauth-impersonation.git"
  },
  "homepage": "https://github.com/qlik-oss/qlik-cloud-embed-oauth-impersonation",
  "bugs": {
    "url": "https://github.com/qlik-oss/qlik-cloud-embed-oauth-impersonation/issues"
  },
  "keywords": [
    "qlik",
    "qlik-cloud",
    "qlik-embed",
    "oauth",
    "impersonation",
    "express"
  ],
  "type": "module",
  "dependencies": {
    "@qlik/api": "^2.24.0",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.11.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "supertest": "^7.3.2"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit && npm run test:browser && npm run test:e2e",
    "test:unit": "node --test --test-reporter=spec \"tests/unit/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/app.js --test-coverage-include=server.js \"tests/unit/**/*.test.js\"",
    "test:browser": "playwright test --config playwright.browser.config.js",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  }
}
